# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Application Key and API Key are generated in Private Center on ecowitt.net.
# MAC is the console's MAC address, shown on the HP2560 Weather Server page.
# Format is colon-separated uppercase hex, e.g. AA:BB:CC:DD:EE:FF
#
# `python -m discovery devices` may be able to report the MAC from the account
# without the console — see README.

ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=
