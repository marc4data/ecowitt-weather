# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Application Key and API Key are generated in Private Center on ecowitt.net.
# MAC is the console's MAC address, shown on the HP2560 Weather Server page.
# Format is colon-separated uppercase hex, e.g. AA:BB:CC:DD:EE:FF
#
# `python -m discovery devices` may be able to report the MAC from the account
# without the console — see README.

ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=

# ---------------------------------------------------------------------------
# Daily lakehouse email (01_DAILY_EMAIL_REQUIREMENTS.md)
#
# These are for running it on THIS machine. On the VM the same values come from
# the systemd unit (addresses) and Secret Manager (everything private) —
# see infra/run_report.sh and infra/deploy_report.sh.
# ---------------------------------------------------------------------------

# Two lists, and NEVER a fallback between them (§5.2). An unset one refuses to
# send rather than quietly using the other. Comma-separated.
#   TO      = the household — everyone who should get the real morning email
#   TEST_TO = you, alone. Every --test and every --selftest goes here.
LAKEHOUSE_EMAIL_TO=
LAKEHOUSE_EMAIL_TEST_TO=

# The sender. For Gmail this MUST be the account the app password belongs to --
# Gmail refuses to send as anyone else. Use a dedicated automation account so
# the daily mail does not fill a personal Sent folder.
LAKEHOUSE_EMAIL_FROM=

# Where replies go. The sending account above is unattended; without this,
# hitting reply on the morning email is the same as doing nothing.
LAKEHOUSE_REPLY_TO=

# A Gmail APP PASSWORD — 16 characters, 2-Step Verification enabled.
# An ordinary account password is always rejected.
# https://myaccount.google.com/apppasswords
LAKEHOUSE_SMTP_PASSWORD=

# Who to call when the house needs a person, as JSON. NEVER put this in a source
# file: it is other people's names and numbers, and the repo is public.
# LAKEHOUSE_CONTACTS='[{"who":"Some HVAC Co","what":"services the A/C"}]'
LAKEHOUSE_CONTACTS=

# The station's page on ecowitt.net, linked from the foot of every email.
# Kept out of the repo because the id identifies the house.
LAKEHOUSE_STATION_URL=

# Where the station is, for charts that get shared outside the household --
# e.g. 'Somewhere, ST'. Out of the repo for the same reason as the URL above:
# 02_DAILY_EMAIL_AS_BUILT §5.2 scrubbed location from a public repo. Anything
# reading it must draw itself without it when unset, not print a placeholder.
LAKEHOUSE_LOCATION_LABEL=

# Optional: lets Claude rewrite the top of an ACTION email in plain English.
# Without it the email still sends, in the checks' own words.
ANTHROPIC_API_KEY=
# Only needed for an identity-linked key (one issued by `ant auth login`), which
# is rejected with a 400 unless the request names its workspace. A plain Console
# API key needs nothing here.
ANTHROPIC_WORKSPACE_ID=
