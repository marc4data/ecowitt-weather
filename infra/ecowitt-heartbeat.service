[Unit]
Description=Ecowitt pipeline heartbeat (staleness + dead-man's switch)
After=postgresql.service

[Service]
Type=oneshot
User=ecowitt
Environment=DB_NAME=ecowitt
# Cadence decided 2026-08-02: hourly pulls. Normal max age is ~60 min plus
# timer jitter, so 150 fires only after roughly two consecutive misses — late
# enough not to flap on jitter, early enough to matter.
Environment=MAX_RUN_AGE_MIN=150
Environment=MAX_BACKUP_AGE_MIN=1560
ExecStart=/opt/ecowitt/heartbeat.sh
StandardOutput=journal
StandardError=journal
